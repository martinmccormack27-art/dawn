<section class="mm-hero">
  <div class="mm-hero__inner page-width">
    <div>
      <h1 class="mm-hero__title">{{ section.settings.heading | escape }}</h1>
      <p class="mm-hero__sub">{{ section.settings.sub | escape }}</p>
      {% if section.settings.cta_label != blank and section.settings.cta_url != blank %}
        <a class="button" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
      {% endif %}
      {% if section.blocks.size > 0 %}
        <div class="mm-hero__ages">
          {% for block in section.blocks %}
            <a class="mm-badge mm-badge--age" href="{{ block.settings.link | default: '#' }}">{{ block.settings.label }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div class="mm-hero__img">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
  </div>

  {% schema %}
  {
    "name": "Hero – Mini Marvels",
    "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Cherish Every Moment" },
      { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Comfortable clothes & playful toys for little explorers." },
      { "type": "image_picker", "id": "image", "label": "Right image" },
      { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Shop new arrivals" },
      { "type": "url", "id": "cta_url", "label": "Primary CTA link" }
    ],
    "blocks": [
      {
        "type": "age",
        "name": "Age button",
        "settings": [
          { "type": "text", "id": "label", "label": "Label", "default": "0–12m" },
          { "type": "url", "id": "link", "label": "Link to collection" }
        ]
      }
    ],
    "max_blocks": 6,
    "presets": [{ "name": "Hero – Mini Marvels" }]
  }
  {% endschema %}
</section>
